{
  "skill_id": "de_local_04_sk03",
  "name": "团购文案生成",
  "type": "atomic",
  "input": {
    "type": "object",
    "required": [
      "brief"
    ],
    "properties": {
      "brief": {
        "type": "string",
        "description": "需求说明：写什么、给谁看、要达到什么目的"
      },
      "key_points": {
        "type": "string",
        "description": "必写要点：必须体现的信息（可选）"
      }
    }
  },
  "output": {
    "type": "object",
    "required": [
      "title",
      "body",
      "notes"
    ],
    "properties": {
      "title": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "3 个备选标题，标注推荐项"
      },
      "body": {
        "type": "string",
        "description": "完整文案，分段清晰"
      },
      "notes": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "结构安排与取舍理由"
      }
    },
    "x-rendered-from": "capability:generate_copy"
  },
  "constraints": {
    "max_input_length": 5000,
    "forbidden_words": [
      "最好",
      "第一",
      "100%"
    ],
    "ai_label_required": true,
    "human_review_required": true,
    "external_api_required": false
  }
}